diff --git a/app/Services/EarningsFilter.php b/app/Services/EarningsFilter.php
new file mode 100644
index 0000000..2d8cf06
--- /dev/null
+++ b/app/Services/EarningsFilter.php
@@ -0,0 +1,31 @@
+<?php
+namespace App\Services;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Carbon\CarbonImmutable;
+class EarningsFilter {
+ public static function apply(Request $request,array $data): array {
+  $filters=$request->validate([
+   'period'=>'nullable|in:all,week,month,year,custom',
+   'enterprise_id'=>'nullable|integer|exists:enterprises,id',
+   'from'=>'required_if:period,custom|nullable|date_format:Y-m-d',
+   'to'=>'required_if:period,custom|nullable|date_format:Y-m-d|after_or_equal:from',
+   'q'=>'nullable|string|max:255',
+  ]);
+  if(!empty($filters['enterprise_id']))abort_unless(DB::table('enterprises')->where('id',$filters['enterprise_id'])->where('user_id',$request->user()->id)->exists(),403);
+  $period=$filters['period']??'all';$today=CarbonImmutable::today();
+  [$from,$to]=match($period){
+   'week'=>[$today->startOfWeek()->toDateString(),$today->toDateString()],
+   'month'=>[$today->startOfMonth()->toDateString(),$today->toDateString()],
+   'year'=>[$today->startOfYear()->toDateString(),$today->toDateString()],
+   'custom'=>[$filters['from'],$filters['to']],default=>[null,null],
+  };
+  $data['transactions']=collect($data['transactions'])->filter(function($t)use($filters,$from,$to){
+   $date=substr($t->occurred_on,0,10);
+   return (empty($filters['enterprise_id'])||(string)$t->enterprise_id===(string)$filters['enterprise_id'])&&(!$from||$date>=$from)&&(!$to||$date<=$to);
+  })->values();
+  $data['transaction_history']=$data['transactions']->filter(fn($t)=>empty($filters['q'])||mb_stripos($t->description,$filters['q'])!==false)->values();
+  $data['earnings_period']=['period'=>$period,'from'=>$from,'to'=>$to];
+  return $data;
+ }
+}
